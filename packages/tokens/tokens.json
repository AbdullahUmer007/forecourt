{
  "$schema": "https://tr.designtokens.org/format/",
  "color": {
    "brand": {
      "50":  { "$type": "color", "$value": "#E6F4F1", "$extensions": { "dark": "#0A2E38" } },
      "100": { "$type": "color", "$value": "#C7E5E1", "$extensions": { "dark": "#0B3A47" } },
      "300": { "$type": "color", "$value": "#5EC7DC", "$extensions": { "dark": "#5EC7DC" } },
      "600": { "$type": "color", "$value": "#0E5A6B", "$extensions": { "dark": "#177A8F", "contrastOnWhite": 7.80 } },
      "700": { "$type": "color", "$value": "#0B4553", "$extensions": { "dark": "#0E5A6B", "contrastOnWhite": 10.55 } },
      "link": { "$type": "color", "$value": "#0B4553", "$description": "Accent TEXT — links, drill-throughs, the info badge tone. Separate from brand-700 because brand-700 is also the primary button's hover BACKGROUND and so cannot carry both jobs: its dark value #0E5A6B measures 2.28:1 against surface-1 dark, which failed AA for every link in the product. Light is brand-700, dark is brand-300.", "$extensions": { "dark": "#5EC7DC", "contrastOnWhite": 10.55, "contrastOnDarkSurface": 9.03 } }
    },
    "accent": {
      "500": { "$type": "color", "$value": "#F59E0B" },
      "700": { "$type": "color", "$value": "#B45309", "$extensions": { "contrastOnWhite": 5.02 } }
    },
    "surface": {
      "1": { "$type": "color", "$value": "#FFFFFF", "$extensions": { "dark": "#16181D" } },
      "2": { "$type": "color", "$value": "#F8FAFC", "$extensions": { "dark": "#0E1013" } },
      "3": { "$type": "color", "$value": "#F1F5F9", "$extensions": { "dark": "#1D2027" } }
    },
    "border": {
      "default": { "$type": "color", "$value": "#E2E8F0", "$extensions": { "dark": "#2A2E36" } },
      "strong":  { "$type": "color", "$value": "#CBD5E1", "$extensions": { "dark": "#3A404A" } }
    },
    "ink": {
      "default": { "$type": "color", "$value": "#0F172A", "$extensions": { "dark": "#FFFFFF" } },
      "muted":   { "$type": "color", "$value": "#475569", "$extensions": { "dark": "#94A3B8" } },
      "subtle":  { "$type": "color", "$value": "#64748B", "$extensions": { "dark": "#7A8598" } }
    },
    "status": {
      "good":     { "$type": "color", "$value": "#0CA30C", "$description": "Always paired with an icon and a label." },
      "warning":  { "$type": "color", "$value": "#FAB219", "$description": "Sub-3:1 on light by design; icon+label is the mitigation." },
      "serious":  { "$type": "color", "$value": "#EC835A", "$description": "Sub-3:1 on light by design; icon+label is the mitigation." },
      "critical": { "$type": "color", "$value": "#D03B3B", "$description": "Unlike warning and serious, critical is NOT sub-3:1 by design — it was chosen to pass on white (4.80:1). It had no dark value, so it inherited the light one and measured 3.70:1 against surface-1 dark, failing AA for the most urgent text in the product. The dark value is the nearest red to the original that clears 4.5:1, measured rather than picked.", "$extensions": { "dark": "#DE5A5A", "contrastOnWhite": 4.80, "contrastOnDarkSurface": 4.83 } }
    },
    "series": {
      "1": { "$type": "color", "$value": "#2A78D6", "$extensions": { "dark": "#3987E5", "hue": "blue" } },
      "2": { "$type": "color", "$value": "#EB6834", "$extensions": { "dark": "#D95926", "hue": "orange" } },
      "3": { "$type": "color", "$value": "#1BAF7A", "$extensions": { "dark": "#199E70", "hue": "aqua" } },
      "4": { "$type": "color", "$value": "#EDA100", "$extensions": { "dark": "#C98500", "hue": "yellow" } },
      "5": { "$type": "color", "$value": "#E87BA4", "$extensions": { "dark": "#D55181", "hue": "magenta" } },
      "6": { "$type": "color", "$value": "#008300", "$extensions": { "dark": "#008300", "hue": "green" } },
      "7": { "$type": "color", "$value": "#4A3AA7", "$extensions": { "dark": "#9085E9", "hue": "violet" } },
      "8": { "$type": "color", "$value": "#E34948", "$extensions": { "dark": "#E66767", "hue": "red" } }
    }
  },
  "font": {
    "family": {
      "sans": { "$type": "fontFamily", "$value": ["Inter", "system-ui", "sans-serif"] },
      "mono": { "$type": "fontFamily", "$value": ["JetBrains Mono", "ui-monospace", "monospace"] }
    }
  },
  "space": {
    "0.5": { "$type": "dimension", "$value": "2px" },
    "1":   { "$type": "dimension", "$value": "4px" },
    "2":   { "$type": "dimension", "$value": "8px" },
    "3":   { "$type": "dimension", "$value": "12px" },
    "4":   { "$type": "dimension", "$value": "16px" },
    "5":   { "$type": "dimension", "$value": "20px" },
    "6":   { "$type": "dimension", "$value": "24px" },
    "8":   { "$type": "dimension", "$value": "32px" },
    "10":  { "$type": "dimension", "$value": "40px" },
    "12":  { "$type": "dimension", "$value": "48px" },
    "16":  { "$type": "dimension", "$value": "64px" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "4px" },
    "md": { "$type": "dimension", "$value": "6px" },
    "lg": { "$type": "dimension", "$value": "10px" }
  },
  "$description": "Source of truth. Style Dictionary generates the Tailwind theme, CSS custom properties and a TypeScript union from this file. No component ever contains a hex code. The series palette is validated for contrast and colour-vision deficiency against #FFFFFF and #16181D — re-run the validator if any hex changes."
}
