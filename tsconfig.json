{
  // The root typecheck program. `pnpm typecheck` pointed at `tsc -b` and a
  // tsconfig.json that did not exist, so it had never once run — every module
  // to date shipped without a type check, because vitest transpiles with
  // esbuild and does not typecheck.
  //
  // One flat program rather than project references: there are 85 source files
  // and no .tsx anywhere (apps/site deliberately has no React in its own code),
  // so the cost of a single pass is trivial and there is no build graph to keep
  // in sync. apps/site keeps its own tsconfig for the Next plugin and editor
  // integration; this one is the CI gate.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    // apps/crm is React. `preserve` matches what Next does with the JSX itself;
    // this program only needs to typecheck it, never emit it.
    "jsx": "preserve",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    // The self-audit tests import the audit tool's checks straight from
    // `apps/audit/src/checks.mjs`. Without allowJs that import is an implicit
    // `any`, which then makes every downstream `.status` and `.finding` an
    // error — and, worse, would have silently typed the audit results as `any`
    // in the one suite that gates our own site's score. Inferring from the JS
    // is better than a hand-written .d.ts that drifts from it.
    "allowJs": true,
    "checkJs": false,
    // Mirrors apps/crm/tsconfig.json and vitest.config.ts. All three have to
    // agree or the CRM typechecks in the editor and fails in CI, which is the
    // worst of the three places to find out.
    "baseUrl": ".",
    "paths": {
      "@/*": ["apps/crm/src/*"],
      "@forecourt/domain": ["packages/domain/src/index.ts"],
      "@forecourt/domain/*": ["packages/domain/src/*.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "apps/site/src/**/*.ts",
    "apps/crm/src/**/*.ts",
    "apps/crm/src/**/*.tsx",
    "tests/**/*.ts",
    "demo/**/*.ts"
  ],
  "exclude": ["node_modules", "**/node_modules", "**/.next", "**/dist"]
}
