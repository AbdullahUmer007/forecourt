{
  "name": "forecourt",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "audit": "node apps/audit/src/index.mjs",
    "audit:fixture": "node apps/audit/src/index.mjs --fixture apps/audit/fixtures/kenningtoncarsales.json",
    "test": "vitest run",
    "test:isolation": "vitest run tests/isolation",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "db:migrate": "node packages/db/scripts/migrate.mjs",
    "db:policies": "node packages/db/scripts/verify-policies.mjs",
    "tokens:build": "node packages/tokens/build.mjs",
    "dev": "pnpm --filter @forecourt/site dev",
    "preview": "tsx demo/build-preview.ts",
    "db:setup": "node packages/db/scripts/setup-local.mjs",
    "db:seed": "tsx packages/db/scripts/seed-demo.mjs"
  },
  "devDependencies": {
    "drizzle-kit": "^0.28.0",
    "drizzle-orm": "^0.45.2",
    "fast-check": "^3.22.0",
    "postgres": "^3.4.9",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "tsx": "^4.19.0"
  }
}
