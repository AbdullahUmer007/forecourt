# TypeScript incremental build cache — a build artifact that was committed by
# accident and shows as modified on every build.
*.tsbuildinfo

# Local media store (dev only — R2 in production)
.media/

# Session tokens minted for local verification. Never committed — they are
# live credentials for a signed-in session.
.tokens.json
.token

# Account passwords written out by a rotation, so they reach a human without
# going through a terminal's scrollback. Read it, store the values in a
# password manager, delete it.
.credentials.txt
